{
  "name": "@galaxie/billing",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma comercial: catálogo de módulos, features, planos e faixas (config/catalog) e, depois, os direitos de cada tenant",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --dir test"
  },
  "dependencies": {
    "@galaxie/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "postgres": "^4.0.0"
  }
}

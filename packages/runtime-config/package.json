{
  "name": "@galaxie/runtime-config",
  "version": "0.1.0",
  "private": true,
  "description": "Configuração da operação em tempo de execução: registro das flags, precedência banco > env > padrão e validação por tipo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",

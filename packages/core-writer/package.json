{
  "name": "@galaxie/core-writer",
  "version": "0.1.0",
  "private": true,
  "description": "Grava o lote neutro (modelo normalizado dos provedores) no core: upsertBatch, máquina de estados do evento, importância e junção do jogo provisório",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@galaxie/apisports-client": "workspace:*",
    "@galaxie/db": "workspace:*",
    "@galaxie/knowledge": "workspace:*",
    "@galaxie/observability": "workspace:*",
    "@galaxie/providers": "workspace:*",
    "@galaxie/rules": "workspace:*",
    "drizzle-orm": "^0.45.4"
  }
}

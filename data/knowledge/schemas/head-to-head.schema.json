{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.galaxie-sports.local/knowledge/head-to-head.schema.json",
  "title": "Confrontos que não são clássicos — data/knowledge/<esporte>/head-to-head/<region>.yaml",
  "description": "Retrospecto histórico geral curado de pares relevantes que não são clássicos (clássico guarda o seu no próprio all_time).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "region", "pairs"],
  "properties": {
    "schema_version": { "const": 1 },
    "region": { "$ref": "common.schema.json#/definitions/slug" },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "teams", "all_time"],
        "properties": {
          "slug": { "$ref": "common.schema.json#/definitions/slug" },
          "teams": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/definitions/slug" }
          },
          "all_time": { "$ref": "common.schema.json#/definitions/allTime" }
        }
      }
    }
  }
}

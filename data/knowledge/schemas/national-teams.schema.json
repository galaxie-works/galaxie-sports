{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.galaxie-sports.local/knowledge/national-teams.schema.json",
  "title": "Seleções — data/knowledge/football/national-teams.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "teams"],
  "properties": {
    "schema_version": { "const": 1 },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{ "$ref": "common.schema.json#/definitions/team" }, { "required": ["country"] }]
      }
    }
  }
}

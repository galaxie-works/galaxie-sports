{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.galaxie-sports.local/knowledge/common.schema.json",
  "title": "Definições comuns da base semântica (schema v1)",
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "kebab-case, minúsculo, sem acentos"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "nullableIsoDate": {
      "oneOf": [{ "$ref": "#/definitions/isoDate" }, { "type": "null" }]
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z]{3})?$",
      "description": "ISO 3166-1 alpha-2 (Inglaterra = GB-ENG)"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/definitions/nonEmptyString" }
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/url" },
      "description": "Todo fato precisa de pelo menos uma URL consultada"
    },
    "allTime": {
      "type": "object",
      "additionalProperties": false,
      "description": "Retrospecto histórico geral, curado de fontes públicas (não é calculado dos jogos da base). Sem número confiável ou com fontes divergentes: omitir.",
      "required": [
        "matches",
        "draws",
        "teams",
        "basis",
        "as_of",
        "sources",
        "review_status"
      ],
      "properties": {
        "matches": {
          "type": "integer",
          "minimum": 1
        },
        "draws": {
          "type": "integer",
          "minimum": 0
        },
        "teams": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "team",
              "wins"
            ],
            "properties": {
              "team": {
                "$ref": "#/definitions/slug"
              },
              "wins": {
                "type": "integer",
                "minimum": 0
              },
              "goals": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Gols marcados no confronto; null quando a fonte não publica (basquete e vôlei: sempre null)"
              }
            }
          }
        },
        "basis": {
          "enum": [
            "all",
            "official"
          ],
          "description": "all = todos os jogos (inclui amistosos); official = só jogos oficiais"
        },
        "as_of": {
          "$ref": "#/definitions/isoDate",
          "description": "Data de referência: último jogo contado pela fonte (ou a atualização da página)"
        },
        "sources": {
          "$ref": "#/definitions/sources"
        },
        "review_status": {
          "$ref": "#/definitions/reviewStatus"
        }
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved"]
    },
    "labelLocale": {
      "type": "string",
      "enum": [
        "pt-BR",
        "es-AR",
        "es-MX",
        "es-CO",
        "es-CL",
        "es-PE",
        "es-UY",
        "es-EC",
        "es-PY",
        "es-BO",
        "es-VE",
        "es",
        "en"
      ]
    },
    "copyLocale": {
      "type": "string",
      "enum": [
        "pt-BR",
        "es-AR",
        "es-MX",
        "es-CO",
        "es-CL",
        "es-PE",
        "es-UY",
        "es-EC",
        "es-PY",
        "es-BO",
        "es-VE",
        "es"
      ]
    },
    "textLocale": {
      "type": "string",
      "enum": ["pt-BR", "es", "es-AR", "es-MX", "es-CO", "es-CL", "es-PE", "es-UY", "es-EC", "es-PY", "es-BO", "es-VE"],
      "description": "Idioma dos textos livres (identity, mascote, torcida, origin, trivia); es = espanhol neutro da América Latina"
    },
    "labels": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/labelLocale" },
      "additionalProperties": { "$ref": "#/definitions/nonEmptyString" }
    },
    "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
    "shortChant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Grito curto ou slogan — nunca letra de hino/canção"
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "names", "api_sports", "nicknames", "sources", "review_status"],
      "properties": {
        "slug": { "$ref": "#/definitions/slug" },
        "names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official", "short"],
          "properties": {
            "official": { "$ref": "#/definitions/nonEmptyString" },
            "short": { "$ref": "#/definitions/nonEmptyString" },
            "abbreviation": { "type": "string", "pattern": "^[\\p{Lu}0-9]{2,5}$" }
          }
        },
        "labels": { "$ref": "#/definitions/labels" },
        "api_sports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team_id", "match"],
          "properties": {
            "team_id": { "type": ["integer", "null"], "minimum": 1 },
            "match": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "country"],
              "properties": {
                "name": { "$ref": "#/definitions/nonEmptyString" },
                "country": { "$ref": "#/definitions/nonEmptyString" }
              }
            }
          }
        },
        "f1db": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "description": "Fórmula 1: id do piloto ou do construtor no F1DB (ex.: ayrton-senna). Liga o perfil ao participante pelo provider_map.",
          "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } }
        },
        "founded": { "$ref": "#/definitions/nullableIsoDate" },
        "country": { "$ref": "#/definitions/countryCode" },
        "city": { "$ref": "#/definitions/nonEmptyString" },
        "region": { "$ref": "#/definitions/nonEmptyString" },
        "colors": { "$ref": "#/definitions/stringList" },
        "nicknames": { "$ref": "#/definitions/stringList" },
        "fans": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "demonym": { "type": ["string", "null"], "minLength": 1 },
            "group_nicknames": { "$ref": "#/definitions/stringList" }
          }
        },
        "mascot": { "type": ["string", "null"], "minLength": 1 },
        "rallying_cries": {
          "type": "array",
          "items": { "$ref": "#/definitions/shortChant" }
        },
        "stadium": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/definitions/nonEmptyString" },
            "nicknames": { "$ref": "#/definitions/stringList" },
            "former_names": {
              "type": "array",
              "description": "Nomes anteriores (naming rights); until = último dia em que o nome valeu",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "until"],
                "properties": {
                  "name": { "$ref": "#/definitions/nonEmptyString" },
                  "until": { "$ref": "#/definitions/isoDate" }
                }
              }
            },
            "city": { "$ref": "#/definitions/nonEmptyString" },
            "api_sports_venue_id": {
              "type": ["integer", "null"],
              "minimum": 1,
              "description": "ID do estádio na api-sports (SOMENTE se verificado); sem ele, o seed casa por nome + cidade"
            }
          }
        },
        "rivals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["team"],
            "properties": {
              "team": { "$ref": "#/definitions/slug" },
              "derby": { "oneOf": [{ "$ref": "#/definitions/slug" }, { "type": "null" }] },
              "intensity": { "$ref": "#/definitions/intensity" }
            }
          }
        },
        "identity": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 400 }
        },
        "copy_hints": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/copyLocale" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cheer": { "type": "array", "items": { "$ref": "#/definitions/shortChant" } },
              "nicknames": { "$ref": "#/definitions/stringList" }
            }
          }
        },
        "world_cup_titles": { "type": "integer", "minimum": 0 },
        "sources": { "$ref": "#/definitions/sources" },
        "review_status": { "$ref": "#/definitions/reviewStatus" }
      }
    }
  }
}

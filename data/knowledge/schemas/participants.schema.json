{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.galaxie-sports.local/knowledge/participants.schema.json",
  "title": "Participantes individuais ou equipes sem país único — data/knowledge/<esporte>/participants/<arquivo>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "participants"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": {
      "enum": ["driver", "constructor", "fighter", "athlete"],
      "description": "Tipo de participante (core.participant.kind) de todos os itens do arquivo"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [{ "$ref": "common.schema.json#/definitions/team" }, { "required": ["country"] }]
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.galaxie-sports.local/knowledge/editorial.schema.json",
  "title": "Perfil editorial dos pilotos da F1 — data/knowledge/formula-1/editorial/<locale>.yaml",
  "description": "Bio, estilo, pontos fortes, momentos marcantes e rivalidades de cada piloto, num idioma, com a fonte de cada item. Lenda (`legend`) tem o perfil completo; `regular`, só a bio curta. Gerado pelo agente f1:bio --perfil e aprovado no painel de revisão. O schema só confere a forma: o validador do agente nunca barra o conteúdo, ele grava os achados (`findings`) para o revisor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locale", "drivers"],
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Fonte como o modelo devolveu; a que não veio da busca é achado grave, não erro"
    },
    "sources": { "type": "array", "items": { "$ref": "#/definitions/source" } }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "locale": { "enum": ["pt-BR", "es"] },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "f1db", "tier", "bio", "review_status"],
        "properties": {
          "slug": {
            "$ref": "common.schema.json#/definitions/slug",
            "description": "f1-<id do piloto no F1DB>, o mesmo de participants/drivers.yaml"
          },
          "name": {
            "$ref": "common.schema.json#/definitions/nonEmptyString",
            "description": "Nome do piloto (o do F1DB), para a lista do painel de revisão"
          },
          "f1db": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": { "id": { "$ref": "common.schema.json#/definitions/slug" } }
          },
          "tier": { "enum": ["legend", "regular"] },
          "bio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "sources"],
            "properties": {
              "text": { "$ref": "#/definitions/text" },
              "sources": { "$ref": "#/definitions/sources" }
            }
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text", "sources"],
            "properties": {
              "kind": {
                "enum": ["aggressive", "smooth", "calculating", "precise", "instinctive", "complete", "consistent"]
              },
              "text": { "$ref": "#/definitions/text" },
              "sources": { "$ref": "#/definitions/sources" }
            }
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "text"],
              "properties": {
                "key": {
                  "enum": [
                    "qualifying",
                    "wet_weather",
                    "overtaking",
                    "defending",
                    "starts",
                    "tyre_management",
                    "car_control",
                    "race_intelligence",
                    "consistency",
                    "technical_feedback",
                    "street_circuits",
                    "high_speed"
                  ]
                },
                "text": { "$ref": "#/definitions/text" },
                "source": { "$ref": "#/definitions/source" }
              }
            }
          },
          "moments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["race", "text"],
              "properties": {
                "year": { "type": "integer", "minimum": 1950, "maximum": 2100 },
                "race": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
                "round": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30,
                  "description": "Rodada da corrida na temporada (a ordem pela data), que liga o momento ao evento da base; sem ela (corrida fora da lista do piloto), o momento fica sem o evento"
                },
                "wet": { "type": "boolean" },
                "text": { "$ref": "#/definitions/text" },
                "source": { "$ref": "#/definitions/source" }
              }
            }
          },
          "rivalries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["driver", "text"],
              "properties": {
                "driver": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["f1db_id", "name"],
                  "properties": {
                    "f1db_id": {
                      "oneOf": [{ "$ref": "common.schema.json#/definitions/slug" }, { "type": "null" }],
                      "description": "null quando o nome não casa com quem largou nas mesmas corridas"
                    },
                    "name": { "$ref": "common.schema.json#/definitions/nonEmptyString" }
                  }
                },
                "text": { "$ref": "#/definitions/text" },
                "source": { "$ref": "#/definitions/source" }
              }
            }
          },
          "findings": {
            "type": "array",
            "description": "Achados do validador do agente (número fora do F1DB, corrida que o piloto não disputou, fonte que não veio da busca...), com o trecho no texto do campo, para o painel de revisão",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "start", "end", "rule", "reason", "severity"],
              "properties": {
                "field": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 },
                "rule": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
                "reason": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
                "severity": { "enum": ["alert", "severe"] }
              }
            }
          },
          "review_status": { "enum": ["draft", "reviewed", "approved"] }
        }
      }
    }
  }
}

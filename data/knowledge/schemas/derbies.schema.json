{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.galaxie-sports.local/knowledge/derbies.schema.json",
  "title": "Clássicos/dérbis — data/knowledge/football/derbies/<region>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "region", "derbies"],
  "properties": {
    "schema_version": { "const": 1 },
    "text_locale": { "$ref": "common.schema.json#/definitions/textLocale" },
    "region": { "$ref": "common.schema.json#/definitions/slug" },
    "derbies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "teams", "scope", "intensity", "sources", "review_status"],
        "properties": {
          "slug": { "$ref": "common.schema.json#/definitions/slug" },
          "name": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
          "aliases": { "$ref": "common.schema.json#/definitions/stringList" },
          "labels": { "$ref": "common.schema.json#/definitions/labels" },
          "teams": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/definitions/slug" }
          },
          "scope": { "enum": ["city", "state", "national", "continental", "international"] },
          "intensity": { "$ref": "common.schema.json#/definitions/intensity" },
          "first_match": { "$ref": "common.schema.json#/definitions/nullableIsoDate" },
          "text_locale": {
            "$ref": "common.schema.json#/definitions/textLocale",
            "description": "Idioma de origin e trivia deste clássico quando difere do topo do arquivo (arquivos com vários países)"
          },
          "origin": { "type": ["string", "null"], "minLength": 1, "maxLength": 400 },
          "trivia": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1, "maxLength": 400 }
          },
          "all_time": { "$ref": "common.schema.json#/definitions/allTime" },
          "sources": { "$ref": "common.schema.json#/definitions/sources" },
          "review_status": { "$ref": "common.schema.json#/definitions/reviewStatus" }
        }
      }
    }
  }
}

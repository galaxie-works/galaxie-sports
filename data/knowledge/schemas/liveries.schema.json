{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.galaxie-sports.local/knowledge/liveries.schema.json",
  "title": "Cores das equipes por época — data/knowledge/formula-1/liveries.yaml",
  "description": "Pintura de cada construtor da F1 por intervalo de temporadas (a McLaren de 1988 é vermelha e branca; a de 2024, papaia). O slug é o id do construtor no F1DB.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "constructors"],
  "properties": {
    "schema_version": { "const": 1 },
    "constructors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "eras", "review_status"],
        "properties": {
          "slug": {
            "$ref": "common.schema.json#/definitions/slug",
            "description": "id do construtor no F1DB (mclaren, red-bull, toro-rosso)"
          },
          "name": { "$ref": "common.schema.json#/definitions/nonEmptyString" },
          "eras": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to", "colors", "livery", "sources"],
              "properties": {
                "from": { "type": "integer", "minimum": 1950, "maximum": 2100 },
                "to": {
                  "oneOf": [{ "type": "integer", "minimum": 1950, "maximum": 2100 }, { "type": "null" }],
                  "description": "Última temporada da pintura; null = até hoje"
                },
                "colors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
                  "description": "[primária, secundária]: a primária é a cor de identidade da época (a oficial da equipe nas transmissões, ou a que domina o carro); hex minúsculo"
                },
                "livery": {
                  "$ref": "common.schema.json#/definitions/nonEmptyString",
                  "description": "A pintura em poucas palavras (pt-BR), com o patrocinador que a definiu"
                },
                "sources": { "$ref": "common.schema.json#/definitions/sources" }
              }
            }
          },
          "review_status": { "enum": ["draft", "reviewed", "approved"] }
        }
      }
    }
  }
}

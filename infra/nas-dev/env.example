# Ambiente da stack `galaxie-sports-dev` do NAS (infra/nas-dev/compose.yml). No Portainer: Stacks › galaxie-sports-dev ›
# Editor › Environment variables. NUNCA commite este arquivo preenchido. Passo a passo: docs/runbooks/ambiente-de-dev.md.
# O que não está no Portainer usa o padrão do compose (todos os padrões são os desligados e baratos abaixo).

# ── infra (sempre ligada) ──────────────────────────────────────────────────────────────────────
POSTGRES_USER=galaxie
POSTGRES_PASSWORD=troque-por-um-segredo
POSTGRES_DB=galaxie_sports
S3_ACCESS_KEY=troque-por-um-segredo
S3_SECRET_KEY=troque-por-um-segredo-longo

# ── workers (só sobem com o perfil `workers`) ─────────────────────────────────────────────────────
# Vazio = não sobe ingestor nem agents. Para ligar: COMPOSE_PROFILES=workers (precisa do registro ghcr.io no Portainer).
COMPOSE_PROFILES=
IMAGE_PREFIX=ghcr.io/galaxie-works/galaxie-sports
IMAGE_TAG=staging
PULL_POLICY=always

# ── api-sports (conta COMPARTILHADA com a produção) ──────────────────────────────────────────────
# Vazio = modo offline: o ingestor lê só do raw espelhado e nunca chama o fornecedor. Preencher só para um teste
# pontual; a reserva do Governor deixa pelo menos 70 % da conta do dia intocada no dev (sem APP_ENV).
APISPORTS_KEY=
APISPORTS_PLAN=free
APISPORTS_PLAN_FOOTBALL=
# Teto de chamadas por minuto (o plano real tem centenas); mantém o dev longe da folga do ao vivo da produção
APISPORTS_PER_MINUTE=10
# Teto de chamadas por dia e esporte do fechamento pós-jogo
POSTGAME_MAX_CALLS_DAY=10

# ── agenda do ingestor e dos agentes: tudo desligado ──────────────────────────────────────────────
# Para ligar um job, defina a variável com um cron de 5 campos (UTC), ex.: SCHEDULE_NORMALIZE_SPORTS=15 * * * *
# A lista completa de variáveis está nos blocos ingestor e agents do compose (SCHEDULE_<JOB>=off por padrão).
# SCHEDULE_EVENTS_CLOCK=off
# SCHEDULE_LIVE_RUN=off

# ── IA (crédito COMPARTILHADO com a produção) ─────────────────────────────────────────────────────
# on | off. off = nenhuma chamada ao LLM, mesmo com chave e job ligado.
AI_STATUS=off
AI_DAILY_TOKEN_BUDGET=100000
# O mínimo aceito é 0.5
AI_DAILY_USD_BUDGET=0.5
AI_AGENT_USD_BUDGETS=lineups=0.1,wtw=0.1,context=0.1,related=0.05,f1profile=0.1,f1bio=0.1,curator=0.1,review=0.05,channels=0.05,live=0.05,assets=0.1
AI_AGENT_DEFAULT_USD_BUDGET=0.05
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── YouTube (chave e 100 buscas/dia COMPARTILHADAS com a produção) ─────────────────────────────────
# on | off. off = o related-run sai sem chamar a Data API (busca nem leitura de canais).
YOUTUBE_SEARCH=off
YOUTUBE_API_KEY=
# Baldes do dev (o gasto do dev não aparece no ledger da produção): busca em consultas/dia, geral em unidades/dia
YOUTUBE_SEARCH_DAILY_QUOTA=5
YOUTUBE_DAILY_QUOTA=200

# Ambiente da stack `galaxie-sports-dev` do NAS (infra/nas-dev/compose.yml, stack a partir do git). No Portainer:
# Stacks › galaxie-sports-dev › Environment variables. NUNCA commite este arquivo preenchido. Passo a passo:
# docs/runbooks/ambiente-de-dev.md › Stack a partir do git.
# O que não está no Portainer usa o padrão do compose (todos os padrões são os desligados e baratos abaixo). Os quatro
# segredos (as três senhas e BACKUP_AGE_IDENTITY, abaixo) não têm padrão: sem eles a stack não sobe (`${VAR:?}`).

# ── infra (sempre ligada) ──────────────────────────────────────────────────────────────────────
POSTGRES_USER=galaxie
POSTGRES_PASSWORD=troque-por-um-segredo
POSTGRES_DB=galaxie_sports
S3_ACCESS_KEY=troque-por-um-segredo
S3_SECRET_KEY=troque-por-um-segredo-longo

# ── imagens do GHCR (migrate sempre; ingestor e agents só com o perfil `workers`) ─────────────────
# Privadas: o Portainer precisa do registro ghcr.io (token read:packages) para puxar qualquer uma, inclusive a do
# migrate, que roda a cada atualização da stack. IMAGE_TAG=main = o que acabou de entrar na main (o docker.yml publica
# a tag a cada push); outra tag (in-<hash>, <sha>) só para um teste pontual, e vale para o migrate também.
IMAGE_PREFIX=ghcr.io/galaxie-works/galaxie-sports
IMAGE_TAG=main
PULL_POLICY=always
# Vazio = não sobe ingestor nem agents. Para ligar: COMPOSE_PROFILES=workers.
COMPOSE_PROFILES=

# ── api-sports (conta COMPARTILHADA com a produção) ──────────────────────────────────────────────
# Vazio = modo offline: o ingestor lê só do raw espelhado e nunca chama o fornecedor. Preencher só para um teste
# pontual; a reserva do Governor deixa pelo menos 70 % da conta do dia intocada no dev (sem APP_ENV).
APISPORTS_KEY=
APISPORTS_PLAN=free
APISPORTS_PLAN_FOOTBALL=
# Teto de chamadas por minuto (o plano real tem centenas); mantém o dev longe da folga do ao vivo da produção
APISPORTS_PER_MINUTE=10
# Teto de chamadas por dia e esporte do fechamento pós-jogo
POSTGAME_MAX_CALLS_DAY=10

# ── agenda do ingestor e dos agentes: tudo desligado ──────────────────────────────────────────────
# Para ligar um job, defina a variável com um cron de 5 campos (UTC), ex.: SCHEDULE_NORMALIZE_SPORTS=15 * * * *
# A lista completa de variáveis está nos blocos ingestor e agents do compose (SCHEDULE_<JOB>=off por padrão).
# SCHEDULE_EVENTS_CLOCK=off
# SCHEDULE_LIVE_RUN=off

# ── IA (crédito COMPARTILHADO com a produção) ─────────────────────────────────────────────────────
# on | off. off = nenhuma chamada ao LLM, mesmo com chave e job ligado.
AI_STATUS=off
AI_DAILY_TOKEN_BUDGET=100000
# O mínimo aceito é 0.5
AI_DAILY_USD_BUDGET=0.5
AI_AGENT_USD_BUDGETS=lineups=0.1,wtw=0.1,context=0.1,related=0.05,f1profile=0.1,f1bio=0.1,curator=0.1,review=0.05,channels=0.05,live=0.05,assets=0.1
AI_AGENT_DEFAULT_USD_BUDGET=0.05
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── YouTube (chave e 100 buscas/dia COMPARTILHADAS com a produção) ─────────────────────────────────
# on | off. off = o related-run sai sem chamar a Data API (busca nem leitura de canais).
YOUTUBE_SEARCH=off
YOUTUBE_API_KEY=
# Baldes do dev (o gasto do dev não aparece no ledger da produção): busca em consultas/dia, geral em unidades/dia
YOUTUBE_SEARCH_DAILY_QUOTA=5
YOUTUBE_DAILY_QUOTA=200

# ── espelho semanal produção → dev (serviço `espelho`; docs/runbooks/ambiente-de-dev.md › Espelho) ─────────────────
# Pasta da stack galaxie-sports-backup-nas (os dumps em daily/ e os assets em s3/), montada só leitura, e a pasta desta
# stack no NAS, onde ficam a cópia de infra/ops/mirror-prod-to-dev.sh e .sql, o recibo e os dumps do dev (estes são os
# padrões do compose)
NAS_BACKUP_PATH=/volume1/Docker/galaxie-sports-backups
NAS_DEV_PATH=/volume1/Docker/galaxie-sports-dev
# Chave PRIVADA do ensaio de restauração (a mesma BACKUP_AGE_IDENTITY do .env da VPS; docs/runbooks/exercicio-dr.md).
# Obrigatória: sem ela a stack não sobe. Só no ambiente da stack, nunca num arquivo do repositório
BACKUP_AGE_IDENTITY=troque-pela-chave-privada-do-ensaio
# Toda segunda às 06:30 UTC (depois da cópia das 05:15 do nas-pull.sh). false = a partida não espelha (true espelha; plan
# só faz a prévia)
ESPELHO_CRON=30 6 * * 1
ESPELHO_ON_START=false
# Prefixos públicos do bucket de assets a copiar para o RustFS do dev (os de NAS_S3_PREFIXES da stack backup-nas, menos
# tasks-bucket, que é recusado: bucket privado, pacotes e uploads de cliente). Vazio = só o banco
ESPELHO_S3_PREFIXES=
ESPELHO_S3_DELETE=false

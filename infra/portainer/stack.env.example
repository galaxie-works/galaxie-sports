# Variáveis da stack de staging (infra/portainer/stack.yml).
# No Portainer: Stacks → Add stack → Environment variables → "Load variables from .env file" e preencha os valores.
# NUNCA commite este arquivo preenchido. Gere segredos com: openssl rand -hex 24
# (use só caracteres seguros para URL nas senhas do Postgres — hex é o mais simples).

# ── domínios / borda ─────────────────────────────────────────────────────────────────────────
API_DOMAIN=api.staging.example.com
GRAFANA_DOMAIN=grafana.staging.example.com
HTTP_PORT=80
HTTPS_PORT=443

# ── imagens ──────────────────────────────────────────────────────────────────────────────────
# Padrão: o Portainer constrói as imagens a partir do repositório (PULL_POLICY=build).
# Com imagens publicadas no GHCR: IMAGE_PREFIX=ghcr.io/galaxie-works/galaxie-sports, IMAGE_TAG=<sha|staging>, PULL_POLICY=always
IMAGE_PREFIX=galaxie-sports
IMAGE_TAG=staging
PULL_POLICY=build

# ── Postgres ─────────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=galaxie
POSTGRES_PASSWORD=troque-por-um-segredo-hex
POSTGRES_DB=galaxie_sports

# ── object storage interno (RustFS) ──────────────────────────────────────────────────────────
S3_BUCKET=galaxie-sports-assets
S3_ACCESS_KEY=troque-por-um-segredo
S3_SECRET_KEY=troque-por-um-segredo-longo
ASSETS_PUBLIC_BASE_URL=

# ── fornecedor ───────────────────────────────────────────────────────────────────────────────
APISPORTS_KEY=troque-pela-chave-do-dashboard
APISPORTS_PLAN=free
# Plano por API: APISPORTS_PLAN_<ESPORTE> (nome da API em maiúsculas, "-" → "_") sobrescreve o padrão acima.
# Vazio = APISPORTS_PLAN. APIs: FOOTBALL, AFL, BASEBALL, BASKETBALL, FORMULA_1, HANDBALL, HOCKEY, MMA, NBA,
# AMERICAN_FOOTBALL, RUGBY, VOLLEYBALL.
# APISPORTS_PLAN_FOOTBALL=pro
QUOTA_RESERVE_PERCENT=15

# ── ingestor (agenda em UTC; "off" desliga) ──────────────────────────────────────────────────
SCHEDULE_SYNC_DAILY=5 0 * * *
SCHEDULE_LIVE_RUN=*/5 * * * *
SCHEDULE_LIVE_RECONCILE=*/10 * * * *
SCHEDULE_NORMALIZE_FOOTBALL=35 0 * * *
SCHEDULE_NORMALIZE_SPORTS=15 * * * *
SCHEDULE_EVENTS_CLOCK=* * * * *
SCHEDULE_ASSETS_MIRROR=30 1 * * *
SCHEDULE_CHANGE_FEED_PRUNE=45 2 * * *
CHANGE_FEED_RETENTION_DAYS=7
SCHEDULE_QUOTA_STATUS=5 * * * *
SCHEDULE_BOOTSTRAP_CATALOG=15 3 * * 1
SCHEDULER_RUN_ON_START=
SCHEDULER_TIMEOUT_MINUTES=
# ao vivo (Live Scheduler/Poller): detalhe do jogo principal a cada tick (off|auto|on), teto do intervalo,
# minutos sem janela antes de sair (o scheduler reinicia) e saldo DAILY protegido (vazio = fatia da política)
LIVE_FEATURED=off
LIVE_MAX_INTERVAL_MINUTES=15
LIVE_IDLE_EXIT_MINUTES=15
LIVE_PROTECT_DAILY=
# menor live_priority acompanhada pelo ao vivo (high|medium|low); a reconciliação usa o mesmo corte
LIVE_MIN_PRIORITY=medium

# ── API ──────────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
METRICS_TOKEN=troque-por-um-segredo
LIVE_POLL_INTERVAL_SECONDS=300
WEBHOOK_SIGNING_SECRET=
# Origens de navegador autorizadas (CORS), separadas por vírgula; vazio = sem CORS
CORS_ORIGINS=
# /internal/admin/*: hashes das chaves administrativas (pnpm --filter @galaxie/api admin:key) e
# IPs/CIDRs autorizados (VPN/rede privada). Sem hash, as rotas administrativas não existem.
ADMIN_KEY_HASHES=
ADMIN_IP_ALLOWLIST=
# IPs/CIDRs dos proxies confiáveis (Caddy) para o IP real do cliente. Padrão da stack: uniquelocal (redes privadas,
# onde está o Caddy). Não use `true`: confia no 1º endereço do X-Forwarded-For, que o cliente forja.
TRUST_PROXY=uniquelocal
HSTS_MAX_AGE=31536000

# ── backups ──────────────────────────────────────────────────────────────────────────────────
BACKUP_TIME=03:30
# 7 dumps diários no volume da VPS; a retenção longa (14 diários, 8 semanais, 12 mensais) é a do NAS
BACKUP_KEEP_DAILY=7
# verificador: último dump com no máximo 26 h; com BACKUP_NAS_RECEIPT=true, também o recibo da cópia do NAS
BACKUP_CHECK_INTERVAL_H=6
BACKUP_NAS_RECEIPT=false
# ensaio de restauração automático (dia do mês, UTC; off desliga)
RESTORE_DRILL_DAY=1
BACKUP_ON_START=true
# Cópia remota opcional (bucket S3-compatível FORA desta VPS; retenção remota via regra de ciclo de vida do bucket)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ── observabilidade ──────────────────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-um-segredo

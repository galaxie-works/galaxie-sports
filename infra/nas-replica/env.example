# Ambiente da stack `nas-replica` do NAS (infra/nas-replica/compose.yml). No Portainer: Stacks › nas-replica ›
# Environment variables. NUNCA commite este arquivo preenchido. Passo a passo: docs/runbooks/replica-no-nas.md.
# Sem padrão (a stack não sobe sem eles): VPS_HOST, NAS_REPLICA_PATH, NAS_BACKUP_PATH, REPLICATOR_PASSWORD, DUMP_PGPASSWORD.

# ── VPS (produção) ────────────────────────────────────────────────────────────────────────────────
# Endereço do SSH da VPS (exemplo de documentação; o real fica só no Portainer) e a porta
VPS_HOST=203.0.113.10
VPS_USER=root
VPS_PORT=22
# Onde o Postgres de produção responde na VPS: o serviço replica-proxy do compose.dados.yml publica em 127.0.0.1:5432
VPS_PG_BIND=127.0.0.1:5432

# ── pastas do NAS ─────────────────────────────────────────────────────────────────────────────────
# Pasta desta stack: replica-entrypoint.sh, dump.sh, ssh/tunnel_ed25519, ssh/known_hosts e, opcional, rclone.conf
NAS_REPLICA_PATH=/volume1/Docker/galaxie-sports-replica
# Pasta da stack galaxie-sports-backup-nas (os dumps em daily/weekly/monthly, nas-lib.sh e ssh/receipt_ed25519)
NAS_BACKUP_PATH=/volume1/Docker/galaxie-sports-backups

# ── réplica ───────────────────────────────────────────────────────────────────────────────────────
# Senha do papel replicador da produção: preparar-replica.sh a gera no .env da VPS (REPLICATOR_PASSWORD); copie de lá
REPLICATOR_PASSWORD=troque-pela-senha-do-replicador
REPLICA_SLOT=nas_replica
# Memória do contêiner da réplica e o cache do Postgres (a produção usa 2560m / 512MB / 1792MB)
REPLICA_MEM_LIMIT=2560m
REPLICA_SHARED_BUFFERS=512MB
REPLICA_EFFECTIVE_CACHE_SIZE=1792MB
# >= o max_connections da produção (130), senão o hot standby não sobe
REPLICA_MAX_CONNECTIONS=130

# ── dumps ─────────────────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=galaxie_sports
# Quem lê tudo na réplica: o papel galaxie_backup da produção (pg_read_all_data) com a senha de DB_URL_BACKUP da VPS
DUMP_PGUSER=galaxie_backup
DUMP_PGPASSWORD=troque-pela-senha-do-galaxie_backup
# Dump diário (UTC; a VPS fazia o dela às 03:30) e o dump na partida do contêiner (só se o último tiver mais de 20 h)
DUMP_CRON=30 3 * * *
DUMP_ON_START=true
DUMP_PREFIX=galaxie_sports_
# Réplica com mais WAL que isto por aplicar (MB, contra a produção) = sem dump, com o motivo no last_dump.txt
DUMP_MAX_LAG_MB=256
# Retenção em daily/weekly/monthly (a mesma do nas-pull.sh) e dos dumps pré-migrate (/dump.sh pre-migrate <rótulo>)
NAS_KEEP_DAILY=7
NAS_KEEP_WEEKLY=4
NAS_KEEP_MONTHLY=6
PRE_MIGRATE_KEEP=2
# Chaves PÚBLICAS do age (as mesmas BACKUP_AGE_RECIPIENTS da VPS, separadas por vírgula). Vazio = dump em claro no NAS.
# A privada da recuperação fica só com o Wagner; a do ensaio, no .env da VPS e na stack galaxie-sports-dev (espelho)
DUMP_AGE_RECIPIENTS=

# ── cópia fora de casa (OPCIONAL, desligada; decisão do Wagner) ───────────────────────────────────
# Remoto do rclone (remoto:bucket[/pasta]) definido em NAS_REPLICA_PATH/rclone.conf, fora do git; ex.: r2:galaxie-dumps
# Vazio = não copia. Com DUMP_AGE_RECIPIENTS vazio o dump.sh recusa enviar, salvo OFFSITE_ALLOW_PLAINTEXT=true
OFFSITE_RCLONE_REMOTE=
OFFSITE_KEEP=2
OFFSITE_ALLOW_PLAINTEXT=false

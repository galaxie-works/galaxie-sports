# Variáveis da stack da VPS (infra/vps-telemetry/compose.yml). Copie para /docker/galaxie-sports/.env e
# deixe com chmod 600. NUNCA commite este arquivo preenchido.
# Segredos: openssl rand -hex 32 (hex evita caracteres que precisariam de escape na URL do Postgres).

# ── domínios (registro A → IP da VPS ANTES de subir: o Let's Encrypt usa desafio HTTP-01) ─────────
DEMO_DOMAIN=sports.example.com
API_DOMAIN=api.sports.example.com
ASSETS_DOMAIN=assets.sports.example.com

# ── imagens (GHCR, publicadas pelo workflow docker.yml no push para a main) ────────────────────
IMAGE_PREFIX=ghcr.io/galaxie-works/galaxie-sports
# SHA do commit mergeado (um tag fixo por deploy; "staging" muda a cada push)
IMAGE_TAG=0000000000000000000000000000000000000000
# always = baixa do GHCR (precisa de docker login com token read:packages se os pacotes forem privados);
# missing = usa imagens já carregadas na VPS (docker save | ssh docker load), sem credencial do GitHub no servidor
PULL_POLICY=always

# ── Postgres ─────────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=galaxie
POSTGRES_PASSWORD=troque-por-um-segredo-hex
POSTGRES_DB=galaxie_sports

# ── object storage interno (RustFS) ──────────────────────────────────────────────────────────
S3_BUCKET=galaxie-sports-assets
S3_ACCESS_KEY=troque-por-um-segredo
S3_SECRET_KEY=troque-por-um-segredo-longo

# ── fornecedor ───────────────────────────────────────────────────────────────────────────────
APISPORTS_KEY=troque-pela-chave-do-dashboard
APISPORTS_PLAN=free
# Plano por API (APISPORTS_PLAN_<ESPORTE>); vazio = APISPORTS_PLAN
APISPORTS_PLAN_FOOTBALL=pro
QUOTA_RESERVE_PERCENT=15

# ── ingestor (agenda em UTC; "off" desliga) ──────────────────────────────────────────────────
SCHEDULE_SYNC_DAILY=5 0 * * *
SCHEDULE_LIVE_RUN=*/5 * * * *
SCHEDULE_LIVE_RECONCILE=*/10 * * * *
SCHEDULE_NORMALIZE_FOOTBALL=35 0 * * *
SCHEDULE_NORMALIZE_SPORTS=15 * * * *
SCHEDULE_EVENTS_CLOCK=* * * * *
SCHEDULE_ASSETS_MIRROR=30 1 * * *
SCHEDULE_CHANGE_FEED_PRUNE=45 2 * * *
CHANGE_FEED_RETENTION_DAYS=7
SCHEDULE_QUOTA_STATUS=5 * * * *
SCHEDULE_BOOTSTRAP_CATALOG=15 3 * * 1
SCHEDULER_RUN_ON_START=
SCHEDULER_TIMEOUT_MINUTES=
LIVE_FEATURED=off
LIVE_MAX_INTERVAL_MINUTES=15
LIVE_IDLE_EXIT_MINUTES=15
LIVE_PROTECT_DAILY=
LIVE_MIN_PRIORITY=medium

# ── API ──────────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
METRICS_TOKEN=troque-por-um-segredo
LIVE_POLL_INTERVAL_SECONDS=300
WEBHOOK_SIGNING_SECRET=
# Piso editorial da base semântica: approved (padrão) | reviewed | draft.
# "draft" mostra perfis ainda não revisados (rivais, gritos de guerra) — use só em demonstração controlada.
SEMANTIC_MIN_REVIEW_STATUS=approved
CORS_ORIGINS=
# Vazios = /internal/admin desligado (seguro para começar)
ADMIN_KEY_HASHES=
ADMIN_IP_ALLOWLIST=
# Gateway da rede da stack (sub-rede fixa 172.30.50.0/24): é por ele que o Traefik (rede do host) chega à API
TRUST_PROXY=172.30.50.1
HSTS_MAX_AGE=31536000

# ── demo ─────────────────────────────────────────────────────────────────────────────────────
# Chave do tenant de demonstração (criada depois do primeiro deploy; ver o README). Vazio = demo sem dados.
GALAXIE_DEMO_KEY=
# Login da demo (Better Auth): segredo das sessões
BETTER_AUTH_SECRET=troque-por-openssl-rand-hex-32
# Primeiro admin: criado na subida se não houver nenhum; recebe o convite por e-mail (entra com código, sem senha)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_NAME=
# Envio dos convites e dos códigos de acesso. Sem SMTP o painel mostra o link do convite para copiar
# e ninguém recebe código (em produção o código nunca vai para o log).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── backups ──────────────────────────────────────────────────────────────────────────────────
BACKUP_TIME=03:30
BACKUP_RETENTION_DAYS=30
BACKUP_ON_START=true
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ── observabilidade ──────────────────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-um-segredo

# ── Agentes de IA (serviço `agents`: resumo, cenário e Onde Assistir) ──
# Sem chave, resumo e cenário gravam o texto determinístico e o Onde Assistir publica só o que os
# direitos determinam (alocação por rodada fica para depois).
AI_PROVIDER=openai
OPENAI_API_KEY=
# Pesquisa de direitos por temporada pelo Gemini (Grounding with Google Search); vazio = AI_PROVIDER
GEMINI_API_KEY=
AI_RIGHTS_PROVIDER=
# Revisão das sugestões de edição da base semântica (job review-suggestions); padrão gemini
AI_REVIEW_PROVIDER=gemini
# IA ligada ou desligada: on | off (off = nenhuma chamada ao LLM; os agentes seguem com o determinístico)
AI_STATUS=on
# Desliga agentes com a IA ligada: agente=off (ex.: wtw=off); agente=on e vazio seguem o AI_STATUS (off desliga todos)
AI_AGENT_STATUS=
# Tetos: um número (limitado a ele) ou "unlimited" (sem limite); 0 é inválido (para desligar, AI_STATUS=off)
# Teto diário de tokens somando os agentes (~US$ 3/dia com 1M no modelo padrão)
AI_DAILY_TOKEN_BUDGET=1000000
# Teto diário em US$ (tokens + buscas na web) somando os agentes
AI_DAILY_USD_BUDGET=10
# Teto diário em US$ por agente (agente=US$ ou agente=unlimited; fora da lista = só o teto global)
AI_AGENT_USD_BUDGETS=lineups=2,wtw=3,context=1.5,related=0.5,f1profile=2,f1bio=unlimited,curator=unlimited,review=unlimited,channels=unlimited,live=unlimited
# Buscas na web por chamada (o Gemini não tem teto na API: vai no prompt e o painel acusa quem passou)
AI_MAX_SEARCHES_PER_CALL=5
# Mercados do Onde Assistir (ISO2, separados por vírgula)
WTW_MARKETS=BR,AR,MX,CO,CL,PE,UY,EC
# Conteúdo relacionado (YouTube Data API v3; a chave tem restrição por IP: libere o IP da VPS)
YOUTUBE_API_KEY=
# Qualidade dos dados (job data-quality, docs/runbooks/qualidade-dos-dados.md): chave de um tenant interno, só leitura,
# para as regras da F1 conferirem o que a API entrega; vazio = essas regras saem "puladas" no painel
QUALITY_API_KEY=
# Relevância mínima (no mercado) para a alocação por rodada usar LLM
WTW_MIN_RELEVANCE=60
# Teto diário em US$ por mercado (custo de cada chamada rateado pelos mercados dela); 0 = sem teto
WTW_DAILY_USD_PER_MARKET=1

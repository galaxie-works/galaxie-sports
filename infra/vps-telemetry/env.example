# Variáveis da stack da VPS (infra/vps-telemetry/compose.yml). Copie para /docker/galaxie-sports/.env e
# deixe com chmod 600. NUNCA commite este arquivo preenchido.
# Segredos: openssl rand -hex 32 (hex evita caracteres que precisariam de escape na URL do Postgres).

# ── domínios (registro A → IP da VPS ANTES de subir: o Let's Encrypt usa desafio HTTP-01) ─────────
DEMO_DOMAIN=sports.example.com
API_DOMAIN=api.sports.example.com
ASSETS_DOMAIN=assets.sports.example.com

# ── imagens (GHCR, publicadas pelo workflow docker.yml no push para a main) ────────────────────
IMAGE_PREFIX=ghcr.io/galaxie-works/galaxie-sports
# SHA do commit mergeado (um tag fixo por deploy; "staging" muda a cada push)
IMAGE_TAG=0000000000000000000000000000000000000000
# always = baixa do GHCR (precisa de docker login com token read:packages se os pacotes forem privados);
# missing = usa imagens já carregadas na VPS (docker save | ssh docker load), sem credencial do GitHub no servidor
PULL_POLICY=always

# ── Postgres ─────────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=galaxie
POSTGRES_PASSWORD=troque-por-um-segredo-hex
POSTGRES_DB=galaxie_sports
# Papéis por serviço (README › Papéis do banco; packages/db/src/roles.ts). POSTGRES_USER é o dono: só o migrate usa.
# on: o migrate cria os papéis e aplica os GRANTs a cada deploy. Cada URL abaixo troca o serviço para o papel dele
# (senha: openssl rand -hex 32, só letras e números); sem a URL, o serviço segue com o dono.
DB_ROLES=off
# DB_URL_API=postgres://galaxie_api:troque-por-um-segredo-hex@postgres:5432/galaxie_sports
# DB_URL_DEMO=postgres://galaxie_demo:troque-por-um-segredo-hex@postgres:5432/galaxie_sports
# DB_URL_INGESTOR=postgres://galaxie_ingestor:troque-por-um-segredo-hex@postgres:5432/galaxie_sports
# DB_URL_AGENTS=postgres://galaxie_agents:troque-por-um-segredo-hex@postgres:5432/galaxie_sports
# DB_URL_BACKUP=postgres://galaxie_backup:troque-por-um-segredo-hex@postgres:5432/galaxie_sports

# ── object storage interno (RustFS) ──────────────────────────────────────────────────────────
S3_BUCKET=galaxie-sports-assets
S3_ACCESS_KEY=troque-por-um-segredo
S3_SECRET_KEY=troque-por-um-segredo-longo

# ── fornecedor ───────────────────────────────────────────────────────────────────────────────
APISPORTS_KEY=troque-pela-chave-do-dashboard
APISPORTS_PLAN=free
# Plano por API (APISPORTS_PLAN_<ESPORTE>); vazio = APISPORTS_PLAN
APISPORTS_PLAN_FOOTBALL=pro
QUOTA_LIVE_RESERVE_PERCENT=25

# ── ingestor (agenda em UTC; "off" desliga) ──────────────────────────────────────────────────
SCHEDULE_SYNC_DAILY=5 0 * * *
SCHEDULE_LIVE_RUN=*/5 * * * *
SCHEDULE_LIVE_RECONCILE=*/10 * * * *
SCHEDULE_NORMALIZE_FOOTBALL=35 0 * * *
SCHEDULE_NORMALIZE_SPORTS=15 * * * *
SCHEDULE_EVENTS_CLOCK=* * * * *
SCHEDULE_ASSETS_MIRROR=30 1 * * *
SCHEDULE_CHANGE_FEED_PRUNE=45 2 * * *
CHANGE_FEED_RETENTION_DAYS=7
SCHEDULE_QUOTA_STATUS=5 * * * *
SCHEDULE_BOOTSTRAP_CATALOG=15 3 * * 1
SCHEDULER_RUN_ON_START=
SCHEDULER_TIMEOUT_MINUTES=
# Teto de jobs simultâneos fora do ao vivo e heap de cada job (MB); a soma cabe no mem_limit (README › Memória dos jobs)
SCHEDULER_MAX_JOBS=2
SCHEDULER_JOB_HEAP_MB=160
AGENTS_MAX_JOBS=3
AGENTS_JOB_HEAP_MB=128
LIVE_FEATURED=off
LIVE_MAX_INTERVAL_MINUTES=15
LIVE_IDLE_EXIT_MINUTES=15
LIVE_PROTECT_DAILY=
LIVE_MIN_PRIORITY=medium

# ── API ──────────────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# obrigatório: Bearer do /metrics da API, o mesmo no Prometheus (openssl rand -hex 32)
METRICS_TOKEN=troque-por-um-segredo
# Segredo do token curto do SSE (openssl rand -hex 32); vazio = aleatório por processo da API
STREAM_TOKEN_SECRET=
LIVE_POLL_INTERVAL_SECONDS=300
WEBHOOK_SIGNING_SECRET=
# Piso editorial da base semântica: approved (padrão) | reviewed | draft.
# "draft" mostra perfis ainda não revisados (rivais, gritos de guerra) — use só em demonstração controlada.
SEMANTIC_MIN_REVIEW_STATUS=approved
CORS_ORIGINS=
# Vazios = /internal/admin desligado (seguro para começar)
ADMIN_KEY_HASHES=
ADMIN_IP_ALLOWLIST=
# Gateway da rede da stack (sub-rede fixa 172.30.50.0/24): é por ele que o Traefik (rede do host) chega à API
TRUST_PROXY=172.30.50.1
HSTS_MAX_AGE=31536000

# ── demo ─────────────────────────────────────────────────────────────────────────────────────
# Chave do tenant de demonstração (criada depois do primeiro deploy; ver o README). Vazio = demo sem dados.
GALAXIE_DEMO_KEY=
# Login da demo (Better Auth): segredo das sessões
BETTER_AUTH_SECRET=troque-por-openssl-rand-hex-32
# Primeiro admin: criado na subida se não houver nenhum; recebe o convite por e-mail (entra com código, sem senha)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_NAME=
# Envio dos convites e dos códigos de acesso. Sem SMTP o painel mostra o link do convite para copiar
# e ninguém recebe código (em produção o código nunca vai para o log).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── página de manutenção (serviço maintenance; README › Página de manutenção) ─────────────────
# Prioridade dos routers dela no Traefik: 1 = só responde quando a demo ou a API está fora (deploy, reinício);
# 10000 = força a manutenção nos dois hosts (aplicar com: docker compose up -d maintenance)
MAINTENANCE_PRIORITY=1

# ── backups ──────────────────────────────────────────────────────────────────────────────────
BACKUP_TIME=03:30
# 7 dumps diários no volume da VPS; a retenção longa (14 diários, 8 semanais, 12 mensais) é a do NAS
BACKUP_KEEP_DAILY=7
# verificador: último dump com no máximo 26 h; com BACKUP_NAS_RECEIPT=true (padrão), também o recibo da cópia do NAS
# (stack galaxie-sports-backup-nas; false só se a cópia do NAS for desligada)
BACKUP_CHECK_INTERVAL_H=6
BACKUP_NAS_RECEIPT=true
# ensaio de restauração automático (dia do mês, UTC; off desliga)
RESTORE_DRILL_DAY=1
BACKUP_ON_START=true
# dumps cifrados com age (docs/runbooks/exercicio-dr.md › Dumps cifrados): públicas da recuperação e do ensaio
# (age1…, separadas por vírgula) e a privada do ensaio (AGE-SECRET-KEY-1…); vazio = dump em claro
BACKUP_AGE_RECIPIENTS=
BACKUP_AGE_IDENTITY=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ── observabilidade ──────────────────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-por-um-segredo
# Alertas (Grafana; docs/runbooks/alertas-e-monitoramento.md). Push no celular para os 5 sinais graves, pelo ntfy:
# tópico com nome secreto e longo (ex.: https://ntfy.sh/galaxie-<32 caracteres aleatórios>; o nome é a senha, gere
# com `openssl rand -hex 16`). ALERT_NTFY_TOKEN só com servidor próprio ou tópico reservado. O mesmo tópico vai nos
# secrets ALERT_NTFY_URL/ALERT_NTFY_TOKEN do ambiente producao do GitHub (aviso de deploy travado).
ALERT_NTFY_URL=
ALERT_NTFY_TOKEN=
# Resumo diário por e-mail (08:00 de Brasília): sem ALERT_EMAIL_TO e ALERT_SMTP_HOST, o resumo sai no push (prioridade
# baixa) ou fica só no Grafana. ALERT_SMTP_HOST no formato host:porta (587 com STARTTLS); a senha fica só aqui.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# Issue no GitHub por alerta (rótulo `alerta`; abre ao disparar e fecha ao resolver, pelo workflow alerta-grafana.yml):
# fine-grained PAT só do repositório galaxie-sports, com Actions: read and write e nada mais. Vazio = sem issue.
ALERT_GITHUB_TOKEN=
ALERT_GITHUB_REPO=

# ── Agentes de IA (serviço `agents`: resumo, cenário e Onde Assistir) ──
# Sem chave, resumo e cenário gravam o texto determinístico e o Onde Assistir publica só o que os
# direitos determinam (alocação por rodada fica para depois).
AI_PROVIDER=openai
OPENAI_API_KEY=
# Pesquisa de direitos por temporada pelo Gemini (Grounding with Google Search); vazio = AI_PROVIDER
GEMINI_API_KEY=
AI_RIGHTS_PROVIDER=
# Revisão das sugestões de edição da base semântica (job review-suggestions); padrão gemini
AI_REVIEW_PROVIDER=gemini
# IA ligada ou desligada: on | off (off = nenhuma chamada ao LLM; os agentes seguem com o determinístico)
AI_STATUS=on
# Desliga agentes com a IA ligada: agente=off (ex.: wtw=off); agente=on e vazio seguem o AI_STATUS (off desliga todos)
AI_AGENT_STATUS=
# Tetos: um número (limitado a ele) ou "unlimited" (sem limite); 0 é inválido (para desligar, AI_STATUS=off)
# Teto diário de tokens somando os agentes (~US$ 3/dia com 1M no modelo padrão)
AI_DAILY_TOKEN_BUDGET=1000000
# Teto diário em US$ (tokens + buscas na web) somando os agentes
AI_DAILY_USD_BUDGET=10
# Teto diário em US$ por agente (agente=US$ ou agente=unlimited); mescla agente a agente sobre os padrões do código
AI_AGENT_USD_BUDGETS=lineups=2,wtw=3,context=1.5,related=0.5,f1profile=2,f1bio=1,curator=1,review=0.5,channels=1,live=0.5,assets=1
# Teto diário em US$ do agente fora da lista (agente novo): conservador, com aviso diário no log
AI_AGENT_DEFAULT_USD_BUDGET=0.5
# Política de execução (#357): faixas por prioridade em % do teto global (somam 100; a reserva só serve a P0),
# corte P0/P1 (audiência mínima) e virada do dia de orçamento. Vazio = padrão; o painel sobrescreve.
AI_BAND_SHARES=p0=45,reserve=10,p1=15,clients=15,rest=5,manual=10
AI_P0_MIN_AUDIENCE=25
AI_BUDGET_DAY_START=06:00
AI_BUDGET_TIMEZONE=America/Sao_Paulo
# Buscas na web por chamada (o Gemini não tem teto na API: vai no prompt e o painel acusa quem passou)
AI_MAX_SEARCHES_PER_CALL=5
# Mercados do Onde Assistir (ISO2, separados por vírgula)
WTW_MARKETS=BR,AR,MX,CO,CL,PE,UY,EC
# Conteúdo relacionado (YouTube Data API v3; a chave tem restrição por IP: libere o IP da VPS)
YOUTUBE_API_KEY=
# Qualidade dos dados (job data-quality, docs/runbooks/qualidade-dos-dados.md): chave de um tenant interno, só leitura,
# para as regras da F1 conferirem o que a API entrega; vazio = essas regras saem "puladas" no painel
QUALITY_API_KEY=
# Relevância mínima (no mercado) para a alocação por rodada usar LLM
WTW_MIN_RELEVANCE=60
# Teto diário em US$ por mercado (custo de cada chamada rateado pelos mercados dela); 0 = sem teto
WTW_DAILY_USD_PER_MARKET=1
# Grade de canais: texto das páginas de planos que vai para a IA na extração (vazio = 150000 cada; o que
# passa é cortado do fim da página e sai no log). Também ajustável no painel (Ajustes → Operação).
LINEUP_PROMPT_MAX_CHARS=
LINEUP_PAGE_MAX_CHARS=

    {
      "id": 9,
      "type": "timeseries",
      "title": "Erro da API (5 min)",
      "description": "api-disponibilidade: 5xx das rotas /v1 + fração do tempo sem raspar a API. api-latencia: requisições das rotas principais acima de 1 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,

        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:sli_error:ratio_rate5m{slo=~\"api-.+\"}",
          "legendFormat": "{{slo}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "p99 por rota principal",
      "description": "Para calibrar o alvo de latência (99% em até 1 s). Os buckets do histograma vão até 10 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(galaxie_http_request_duration_seconds_bucket{job=\"galaxie-api\",method=\"GET\",route=~\"/v1/events|/v1/events/live|/v1/events/:id|/v1/events/:id/(timeline|stats|lineups)|/v1/competitions/:id/seasons/:season/standings|/v1/teams/:id/overview\",status_code!~\"5..\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ao vivo, frescor e backup (1 = bom)",
      "description": "slo:ao_vivo:ok só existe com jogo do plano em andamento. slo:frescor_diario:ok: sync-daily com sucesso há ≤ 26 h. slo:backup:ok: dump ≤ 26 h e verificador sem falha.",

{
  "uid": "galaxie-slo",
  "title": "Galaxie Sports · SLOs e orçamento de erro",
  "description": "SLOs de docs/14-slos-e-error-budget.md: orçamento de 28 dias, queima e indicadores. Regras em infra/observability/prometheus/slo.yml.",
  "tags": ["galaxie", "slo"],
  "timezone": "utc",
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys (versão nova no ar)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 1)",
        "expr": "max by (service, image_hash) (build_info{job=~\"galaxie-api|galaxie-services\"}) unless max by (service, image_hash) (build_info{job=~\"galaxie-api|galaxie-services\"} offset 1m)",
        "step": "1m",
        "titleFormat": "Deploy {{service}}",
        "textFormat": "Versão in-{{image_hash}} (hash da entrada da imagem; o SHA do deploy está nas notas da versão)",
        "tagKeys": "service,image_hash"
      }
    ]
  },
  "panels": [
    {
      "id": 101,
      "type": "row",

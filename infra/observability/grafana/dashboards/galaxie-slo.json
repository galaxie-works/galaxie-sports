    {
      "id": 110,
      "type": "table",
      "title": "Versão no ar por serviço",
      "description": "Hash da entrada da imagem (tag in-<hash>) que cada serviço roda e há quanto tempo o processo está no ar. O SHA do deploy está nas notas de versão (tag deploy-AAAA-MM-DD.N), ao lado destes hashes. A demo não é raspada: GET /api/version.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "No ar há"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Serviço",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service, image_hash) (build_info)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service) (time() - process_start_time_seconds{job=~\"galaxie-api|galaxie-services\"})",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [

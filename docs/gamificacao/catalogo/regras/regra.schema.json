{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://galaxie.works/schemas/game/regra.schema.json",
  "title": "Regra de Conquista",
  "description": "Regra declarativa que o motor de Conquistas lê (docs/gamificacao/catalogo/regras/linguagem.md).",
  "type": "object",
  "required": ["input"],
  "properties": {
    "input": { "enum": ["prediction", "participation", "moment"] },
    "where": { "$ref": "#/$defs/where" },
    "count": { "$ref": "#/$defs/count" }
  },
  "allOf": [
    {
      "if": { "properties": { "input": { "const": "prediction" } } },
      "then": {
        "properties": {
          "kind": { "enum": ["exact_score", "winner", "quantity"] },
          "correct": { "type": "boolean" },
          "fullHit": { "type": "boolean" }
        },
        "additionalProperties": false,
        "propertyNames": { "enum": ["input", "kind", "correct", "fullHit", "where", "count"] }
      }
    },
    {
      "if": { "properties": { "input": { "const": "participation" } } },
      "then": {
        "required": ["action"],
        "properties": { "action": { "enum": ["watched", "poll", "trivia", "consumption"] } },
        "propertyNames": { "enum": ["input", "action", "where", "count"] }
      }
    },
    {
      "if": { "properties": { "input": { "const": "moment" } } },
      "then": {
        "required": ["fact"],
        "properties": {
          "fact": {
            "enum": [
              "football.goal",
              "football.hat_trick",
              "football.penalty_missed",
              "football.red_card",
              "football.var_goal_disallowed",
              "football.comeback",
              "football.result",
              "game.result",
              "game.comeback",
              "score.result",
              "score.comeback",
              "score.period",
              "baseball.no_hitter",
              "race.result",
              "fight.result"
            ]
          },
          "params": { "$ref": "#/$defs/params" },
          "presence": { "enum": ["at_moment", "game"], "default": "game" }
        },
        "propertyNames": { "enum": ["input", "fact", "params", "presence", "where", "count"] }
      }
    }
  ],
  "$defs": {
    "team": { "enum": ["any", "favorite", "opponent"], "default": "any" },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team": { "$ref": "#/$defs/team" },
        "side": { "enum": ["home", "away"] },
        "in_extra": { "type": "boolean" },
        "min_minute": { "type": "integer", "minimum": 0 },
        "max_minute": { "type": "integer", "minimum": 0 },
        "period": { "type": "string" },
        "detail": { "enum": ["normal", "own_goal", "penalty"] },
        "decisive": { "type": "boolean" },
        "equalizer": { "type": "boolean" },
        "winner": { "type": "boolean" },
        "min_goals": { "type": "integer", "minimum": 2 },
        "from_behind_by": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["win", "draw", "loss"] },
        "extra_time": { "type": "boolean" },
        "penalties": { "type": "boolean" },
        "clean_sheet": { "type": "boolean" },
        "margin_min": { "type": "integer", "minimum": 1 },
        "margin_max": { "type": "integer", "minimum": 0 },
        "total_min": { "type": "integer", "minimum": 1 },
        "scoreless": { "type": "boolean" },
        "overtime": { "type": "boolean" },
        "shootout": { "type": "boolean" },
        "shutout": { "type": "boolean" },
        "sets": { "enum": ["3-0", "3-1", "3-2"] },
        "period_sweep": { "type": "boolean" },
        "trailing_by_min": { "type": "integer", "minimum": 1 },
        "at": { "enum": ["any", "last_regular"] },
        "points_min": { "type": "integer", "minimum": 1 },
        "position_max": { "type": "integer", "minimum": 1 },
        "places_gained_min": { "type": "integer", "minimum": 1 },
        "pole_to_win": { "type": "boolean" },
        "winner_from_grid_min": { "type": "integer", "minimum": 2 },
        "finishers_min": { "type": "integer", "minimum": 1 },
        "pits_max": { "type": "integer", "minimum": 0 },
        "won_type": { "enum": ["ko_tko", "submission", "decision"] },
        "round_max": { "type": "integer", "minimum": 1 },
        "minute_max": { "type": "string", "pattern": "^[0-9]:[0-5][0-9]$" }
      }
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sport": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "competition_type": { "type": "array", "minItems": 1, "items": { "enum": ["league", "cup", "tournament"] } },
        "stage": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "derby": { "const": true },
        "favorite_playing": { "const": true },
        "local_hour": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "to": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
          }
        },
        "weekday": { "type": "array", "minItems": 1, "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } }
      }
    },
    "count": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["each", "distinct", "streak"] },
        "key": { "enum": ["competition", "country", "sport", "team", "stage", "season", "month", "weekday"] },
        "unit": { "enum": ["round", "game", "day", "prediction"] }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "distinct" } } }, "then": { "required": ["key"] } },
        { "if": { "properties": { "mode": { "const": "streak" } } }, "then": { "required": ["unit"] } }
      ]
    }
  }
}

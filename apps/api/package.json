{
  "name": "@galaxie/api",
  "version": "0.1.0",
  "private": true,
  "description": "API pública Galaxie Sports (espelho compatível + /v1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src --passWithNoTests",
    "test:integration": "vitest run --dir test",
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "tenant:create": "node --env-file-if-exists=../../.env dist/cli/tenant-create.js"
  },
  "dependencies": {
    "@galaxie/apisports-client": "workspace:*",
    "@galaxie/contracts": "workspace:*",
    "@galaxie/db": "workspace:*",
    "@galaxie/where-to-watch": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}

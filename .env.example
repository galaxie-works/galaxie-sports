# api-sports.io — uma única chave do dashboard vale para todas as APIs (cota separada por esporte)
APISPORTS_KEY=
APISPORTS_PLAN=free            # free | pro | ultra | mega — plano padrão de todas as APIs
# Cada API tem assinatura própria: APISPORTS_PLAN_<ESPORTE> sobrescreve o padrão para uma API
# (nome da API em maiúsculas, "-" → "_": FOOTBALL, AFL, BASEBALL, BASKETBALL, FORMULA_1, HANDBALL,
# HOCKEY, MMA, NBA, AMERICAN_FOOTBALL, RUGBY, VOLLEYBALL). Vale para regras do plano, limite por minuto
# e Quota Governor.
# APISPORTS_PLAN_FOOTBALL=pro
QUOTA_RESERVE_PERCENT=15       # reserva de segurança por API/dia

# Banco, filas e storage (valores padrão da infra local: infra/docker-compose.yml)
POSTGRES_USER=galaxie
POSTGRES_PASSWORD=galaxie
POSTGRES_DB=galaxie_sports
DATABASE_URL=postgres://galaxie:galaxie@localhost:5433/galaxie_sports
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=galaxie-sports-assets
S3_ACCESS_KEY=galaxie
S3_SECRET_KEY=galaxie-secret
# S3_REGION=us-east-1          # opcional (padrão us-east-1; o RustFS ignora)
ASSETS_PUBLIC_BASE_URL=http://localhost:9000/galaxie-sports-assets   # base pública do bucket/CDN usada na reescrita das URLs de mídia

# IA — provedor trocável: openai | anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos por nível (light = barato/rápido, standard = redação, research = busca na web)
AI_MODEL_LIGHT=
AI_MODEL_STANDARD=
AI_MODEL_RESEARCH=
# padrões (2026-10): openai light=gpt-6-luna, standard/research=gpt-6.1-sol ·
#                    anthropic light=claude-haiku-5-5, standard/research=claude-sonnet-5-5
AI_DAILY_TOKEN_BUDGET=2000000  # tokens/dia (UTC) somando todos os agentes; 0 ou "unlimited" = sem limite
# AI_MAX_RETRIES=3             # tentativas extras em 429/5xx/timeout/saída fora do schema
# AI_TIMEOUT_MS=180000

# Onde assistir
# WTW_MARKETS=BR,AR            # sobrescreve os mercados ativos (padrão: os dos tenants com where_to_watch)
# WTW_BLOCKLIST_FILE=          # YAML fora do Git com a blocklist editorial (formato de config/broadcasters/_policy.yaml)
# WTW_BLOCKLIST=               # nomes/domínios bloqueados separados por vírgula

# Conteúdo relacionado (docs/12) — YouTube Data API v3. A chave fica SÓ aqui no .env (nunca no Git):
# Google Cloud Console → APIs e serviços → YouTube Data API v3 → Credenciais → Chave de API.
YOUTUBE_API_KEY=
# YOUTUBE_DAILY_QUOTA=10000              # unidades/dia do projeto (zera à meia-noite do Pacífico)
# YOUTUBE_QUOTA_RESERVE_PERCENT=10       # reserva que o related:run nunca gasta
# RELATED_RESEARCH_HOURS=12              # busca completa no máximo a cada N h por evento; no meio, só revalida
# RELATED_CREATOR_MIN_SUBSCRIBERS=100000 # inscritos mínimos para canal fora da allowlist (só reação/análise)

# API pública
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080   # anunciada no OpenAPI (/openapi.json)
SSE_MAX_CONNECTIONS_PER_TENANT=100    # conexões /v1/stream simultâneas por tenant (todas as instâncias)
# Worker de webhooks (pnpm --filter @galaxie/api webhooks:worker). O segredo de assinatura é por
# endpoint, gerado no cadastro (pnpm --filter @galaxie/api webhook create ...).
WEBHOOK_MAX_ATTEMPTS=10        # tentativas até a DLQ
WEBHOOK_RETRY_BASE_MS=10000    # 1ª retentativa; dobra a cada falha (teto 1 h)
WEBHOOK_TIMEOUT_MS=10000
# RULES_DIR=                 # regulamentos (padrão: config/rules do monorepo)
# MEDIA_DENYLIST_PATH=       # mídia bloqueada no espelho (padrão: config/assets/denylist.yaml)
# Piso editorial da base semântica servida pela API: draft | reviewed | approved (padrão approved = produção).
# Em desenvolvimento local use draft — toda a base ainda está em revisão. O cliente só pode endurecer (?min_review_status=).
SEMANTIC_MIN_REVIEW_STATUS=draft
# KNOWLEDGE_DIR=/caminho/para/data/knowledge   # opcional: pasta da base (glossário); padrão = data/knowledge do repositório
# Hardening (SECURITY.md) — todos opcionais em desenvolvimento
CORS_ORIGINS=                  # origens de navegador autorizadas, separadas por vírgula (vazio = sem CORS)
ADMIN_KEY_HASHES=              # sha256$... de `pnpm --filter @galaxie/api admin:key` (vazio = /internal/admin desligado)
ADMIN_IP_ALLOWLIST=            # IPs/CIDRs autorizados em /internal/admin (ex.: 127.0.0.1,::1,10.0.0.0/8)
TRUST_PROXY=                   # true | IPs/CIDRs dos proxies confiáveis (vazio = IP do socket)
API_BODY_LIMIT=                # bytes (padrão 65536)
HSTS_MAX_AGE=                  # s; só atrás de HTTPS (produção: 31536000)

# Demo
NEXT_PUBLIC_GALAXIE_API_URL=http://localhost:8080
GALAXIE_DEMO_KEY=
# Login da demo (Better Auth; tabelas no schema demo_auth). Segredo: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DEMO_DATABASE_URL=postgres://galaxie:galaxie@localhost:5433/galaxie_sports
# Primeiro admin (criado na subida se não houver nenhum; o link do convite sai no log sem SMTP)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_NAME=
# Envio de convites e redefinição de senha (vazio = link no log e no painel)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# api-sports.io — uma única chave do dashboard vale para todas as APIs (cota separada por esporte)
APISPORTS_KEY=
APISPORTS_PLAN=free            # free | pro | ultra | mega
QUOTA_RESERVE_PERCENT=15       # reserva de segurança por API/dia

# Banco, filas e storage (valores padrão da infra local: infra/docker-compose.yml)
POSTGRES_USER=galaxie
POSTGRES_PASSWORD=galaxie
POSTGRES_DB=galaxie_sports
DATABASE_URL=postgres://galaxie:galaxie@localhost:5433/galaxie_sports
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=galaxie-sports-assets
S3_ACCESS_KEY=galaxie
S3_SECRET_KEY=galaxie-secret
# S3_REGION=us-east-1          # opcional (padrão us-east-1; o RustFS ignora)
ASSETS_PUBLIC_BASE_URL=http://localhost:9000/galaxie-sports-assets   # base pública do bucket/CDN usada na reescrita das URLs de mídia

# IA
ANTHROPIC_API_KEY=
AI_MODEL_WTW=claude-sonnet-5-5
AI_MODEL_LIVE=claude-haiku-5-5
AI_MODEL_CURATOR=claude-opus-5-5
AI_DAILY_TOKEN_BUDGET=2000000

# API pública
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080   # anunciada no OpenAPI (/openapi.json)
WEBHOOK_SIGNING_SECRET=

# Demo
NEXT_PUBLIC_GALAXIE_API_URL=http://localhost:8080
GALAXIE_DEMO_KEY=

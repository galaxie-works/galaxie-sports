{
  "name": "@galaxie/ai-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agentes de IA: live scheduler, onde assistir, cenário, resumo, curadoria semântica e guardrails",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "default": "./dist/guardrails/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "default": "./dist/llm/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src --passWithNoTests",
    "test:integration": "vitest run --dir test",
    "context:run": "node --env-file-if-exists=../../.env dist/cli/context-run.js",
    "recap:run": "node --env-file-if-exists=../../.env dist/cli/recap-run.js",
    "curator:run": "node --env-file-if-exists=../../.env dist/cli/curator-run.js",
    "eval:report": "node --env-file-if-exists=../../.env dist/cli/eval-report.js",
    "wtw:run": "node --env-file-if-exists=../../.env dist/cli/wtw-run.js",
    "wtw:audit": "node --env-file-if-exists=../../.env dist/cli/wtw-audit.js",
    "related:run": "node --env-file-if-exists=../../.env dist/cli/related-run.js",
    "related:canais": "node --env-file-if-exists=../../.env dist/cli/related-channels.js",
    "wtw:rights": "node --env-file-if-exists=../../.env dist/cli/wtw-rights.js",
    "wtw:channel": "node --env-file-if-exists=../../.env dist/cli/wtw-channel.js",
    "f1:bio": "node --env-file-if-exists=../../.env dist/cli/f1-bio.js",
    "lineups:research": "node --env-file-if-exists=../../.env dist/cli/lineups-research.js",
    "lineups:pages": "node --env-file-if-exists=../../.env dist/cli/lineups-pages.js",
    "lineups:curate": "node --env-file-if-exists=../../.env dist/cli/lineups-curate.js",
    "wtw:rights:compare": "node --env-file-if-exists=../../.env dist/cli/wtw-rights-compare.js",
    "review:suggestions": "node --env-file-if-exists=../../.env dist/cli/review-suggestions.js",
    "channels:match": "node --env-file-if-exists=../../.env dist/cli/channel-lists.js",
    "ai:status": "node --env-file-if-exists=../../.env dist/cli/ai-status.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@galaxie/ai-ledger": "workspace:*",
    "@galaxie/contracts": "workspace:*",
    "@galaxie/db": "workspace:*",
    "@galaxie/geo": "workspace:*",
    "@galaxie/knowledge": "workspace:*",
    "@galaxie/net-guard": "workspace:*",
    "@galaxie/providers": "workspace:*",
    "@galaxie/rules": "workspace:*",
    "@galaxie/runtime-config": "workspace:*",
    "@galaxie/where-to-watch": "workspace:*",
    "ajv": "^8.20.0",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "openai": "^7.44.0",
    "playwright-core": "1.64.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@galaxie/ingestor": "workspace:*",
    "@galaxie/providers": "workspace:*",
    "postgres": "^3.4.9"
  }
}

{
  "name": "@galaxie/ingestor",
  "version": "0.1.0",
  "private": true,
  "description": "Workers de bootstrap, sync diário, live poller e espelho de assets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src --passWithNoTests",
    "quota": "node --env-file-if-exists=../../.env dist/cli/quota.js",
    "test:integration": "vitest run --dir test",
    "raw:import": "node --env-file-if-exists=../../.env dist/cli/import-raw.js",
    "bootstrap:catalog": "node --env-file-if-exists=../../.env dist/cli/bootstrap-catalog.js",
    "scheduler": "node --env-file-if-exists=../../.env dist/cli/scheduler.js",
    "multisport:seed": "node --env-file-if-exists=../../.env dist/cli/multisport-seed.js",
    "multisport:wikidata": "node --env-file-if-exists=../../.env dist/cli/multisport-wikidata.js",
    "multisport:qa": "node --env-file-if-exists=../../.env dist/cli/multisport-qa.js",
    "normalize:football": "node --env-file-if-exists=../../.env dist/cli/normalize-football.js",
    "names:derive": "node --env-file-if-exists=../../.env dist/cli/derive-names.js",
    "normalize:sports": "node --env-file-if-exists=../../.env dist/cli/normalize-sports.js",
    "events:clock": "node --env-file-if-exists=../../.env dist/cli/events-clock.js",
    "events:importance": "node --env-file-if-exists=../../.env dist/cli/events-importance.js",
    "change-feed:prune": "node --env-file-if-exists=../../.env dist/cli/change-feed-prune.js",
    "bootstrap:seasons": "node --env-file-if-exists=../../.env dist/cli/bootstrap-seasons.js",
    "bootstrap:details": "node --env-file-if-exists=../../.env dist/cli/bootstrap-details.js",
    "bootstrap:people": "node --env-file-if-exists=../../.env dist/cli/bootstrap-people.js",
    "sync:daily": "node --env-file-if-exists=../../.env dist/cli/sync-daily.js",
    "live:run": "node --env-file-if-exists=../../.env dist/cli/live-run.js",
    "live:reconcile": "node --env-file-if-exists=../../.env dist/cli/live-reconcile.js",
    "live:simulate": "node --env-file-if-exists=../../.env dist/cli/live-simulate.js",
    "standings:recompute": "node --env-file-if-exists=../../.env dist/cli/standings-recompute.js",
    "snapshot:export": "node --env-file-if-exists=../../.env dist/cli/snapshot-export.js",
    "snapshot:import": "node --env-file-if-exists=../../.env dist/cli/snapshot-import.js",
    "bootstrap:sports": "node --env-file-if-exists=../../.env dist/cli/bootstrap-sports.js",
    "mma": "node --env-file-if-exists=../../.env dist/cli/mma.js",
    "assets:mirror": "node --env-file-if-exists=../../.env dist/cli/mirror-assets.js",
    "assets:palette": "node --env-file-if-exists=../../.env dist/cli/assets-palette.js",
    "geo:seed": "node --env-file-if-exists=../../.env dist/cli/geo-seed.js",
    "equestrian:import": "node --env-file-if-exists=../../.env dist/cli/equestrian-import.js",
    "provisional:sync": "node --env-file-if-exists=../../.env dist/cli/provisional-sync.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@galaxie/apisports-client": "workspace:*",
    "@galaxie/db": "workspace:*",
    "@galaxie/geo": "workspace:*",
    "@galaxie/knowledge": "workspace:*",
    "@galaxie/observability": "workspace:*",
    "@galaxie/providers": "workspace:*",
    "@galaxie/rules": "workspace:*",
    "@galaxie/runtime-config": "workspace:*",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "postgres": "^3.4.9"
  }
}
